#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_atomic_float : require

#include "restirdi_commons.h"
#include "restirdi_commons.glsl"

void main() {
	load_g_buffer();
	vec3 col = vec3(0);
	const RestirReservoir r = spatial_reservoirs.d[pixel_idx];
	col += tmp_col.d[pixel_idx];
	if (isnan(luminance(col))) {
		return;
	}
	if (r.W > 0) {
		// light_triangle_count compensates for the missing 1/num_triangles factor in
		// sample_light_Li for LIGHT_AREA.  For LIGHT_SPHERE (and other types) the pdf
		// is already complete, so no extra scaling.
		const uint sel_light_type = get_light_type(lights[r.s.light_idx].light_flags);
		const float tri_scale = (sel_light_type == LIGHT_AREA) ? float(pc.light_triangle_count) : 1.0;
		col += r.W * calc_L_with_visibility_check(r) * tri_scale;
	}
	// Always write temporal even when W==0: prevents stale large-W values from
	// persisting across frames where Z=0 caused spatial to output W=0.
	temporal_reservoirs.d[pixel_idx].w_sum = r.w_sum;
	temporal_reservoirs.d[pixel_idx].W = r.W;
	temporal_reservoirs.d[pixel_idx].m = r.m;
	temporal_reservoirs.d[pixel_idx].s = r.s;
	tmp_col.d[pixel_idx] = vec3(0);
	if (pc.frame_num == 0 || pc.enable_accumulation == 0) {
		imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(col, 1.f));
	} else {
		float w = 1. / float(pc.frame_num + 1);
		vec3 old_col = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).xyz;
		imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(mix(old_col, col, w), 1.f));
	}
}